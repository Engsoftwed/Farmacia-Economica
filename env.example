# ===== PHARMAGNO / FIREBIRD =====
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\MAGNO SYSTEM\PHARMAGNO\SISGEMP.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=COLOQUE_A_SENHA_DO_FIREBIRD
FIREBIRD_CHARSET=ISO8859_1

# ===== SUPABASE =====
# URL do projeto usado pelo site
SUPABASE_URL=https://jefxpjzobwouzvzylqpj.supabase.co
# Use aqui SOMENTE a chave service_role/secret do Supabase.
# Ela fica apenas no computador da farmácia e NUNCA deve ir para assets/js/config.js.
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_SERVICE_ROLE_KEY

# ===== SINCRONIZAÇÃO =====
# 30 segundos. Pode aumentar para 60 se preferir reduzir consultas.
SYNC_INTERVAL_SECONDS=30
# Atualiza nome, preço cheio, promoção e estoque.
SYNC_PRODUCT_NAME=true
# Produtos novos encontrados no Pharmagno entram automaticamente no Supabase.
SYNC_INSERT_NEW_PRODUCTS=true
# Registra logs em ./logs/sincronizador.log
LOG_TO_FILE=true
